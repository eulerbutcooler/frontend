# Copy to frontend/.env on the server.
# API_URL is server-side (Next.js -> Go backend).
API_URL=http://127.0.0.1:8080
# Browser calls normal API routes same-origin; Next rewrites them to API_URL.
NEXT_PUBLIC_API_URL=
# TUS uploads go directly to the Go backend. Replace with the public backend
# origin, e.g. https://api.example.com, if you put a reverse proxy in front.
NEXT_PUBLIC_UPLOAD_URL=http://__SERVER_HOST__:8080
NEXT_PUBLIC_MINIO_HOST=127.0.0.1
NEXT_PUBLIC_MINIO_PORT=9000

RAG_URL=http://127.0.0.1:8000

# Must be 32+ chars. Generate a separate value from the backend JWT secrets.
AUTH_SECRET=__AUTH_SECRET__
AUTH_TRUST_HOST=true
# Set these when serving through a domain/reverse proxy:
# AUTH_URL=https://your-domain.example
# NEXTAUTH_URL=https://your-domain.example

# Must match backend RAG_INTERNAL_TOKEN and ragpy INTERNAL_TOKEN.
INTERNAL_TOKEN=__RAG_INTERNAL_TOKEN__
